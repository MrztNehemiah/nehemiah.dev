---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Nehemiah — DevOps Engineer",
  description = "I design and operate the infrastructure that lets software teams ship faster and sleep better."
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.png" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>

  <nav>
    <div class="nav-inner">
        <li><a href="#about">about</a></li>
        <li><a href="#skills">skills</a></li>
        <li><a href="#projects">projects</a></li>
        <li><a href="#experience">experience</a></li>
        <li><a href="#blog">writing</a></li>
        <li><a href="#contact">contact</a></li>
      </ul>
    </div>
  </nav>

  <slot />

  <footer>
    <div class="footer-inner">
      <span>© {new Date().getFullYear()} Nehemiah.</span>
      <div style="display:flex;gap:1.2rem;">
        <a href="https://github.com/nehemiah-dev" target="_blank" rel="noopener" style="color:var(--text-muted);transition:color .15s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">GitHub</a>
        <a href="https://www.linkedin.com/in/nehemiah-daniel-844177231/" target="_blank" rel="noopener" style="color:var(--text-muted);transition:color .15s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">LinkedIn</a>
        <a href="mailto:hello@nehemiah.dev" style="color:var(--text-muted);transition:color .15s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--text-muted)'">Email</a>
      </div>
    </div>
  </footer>

</body>
</html>
