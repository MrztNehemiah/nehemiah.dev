---
const roles = [
  {
    title: "DevOps Engineer",
    company: "EnergyIQ",
    period: "2026 — present",
    location: "Remote, Nigeria",
    current: true,
    bullets: [
      "Designed, built, and operate CI/CD pipelines that automate software delivery, enabling reliable and repeatable deployments. ",
      "Reduced CI/CD pipeline execution time by 40% through dependency caching, parallel job execution, and elimination of redundant workflow stages.",
      "Migrated manually provisioned AWS infrastructure to reusable Terraform modules, establishing version-controlled, reproducible infrastructure provisioning",
      "Designed and implemented an observability platform introducing SLOs, SLIs, and error budgets to guide reliability engineering.",
      "Standardized deployment runbooks, operational documentation, and incident response procedures",
    ],
  },
  
];
---
<section id="experience">
  <div class="container">
    <p class="section-label">experience</p>   
    <div class="timeline">
      {roles.map((role, i) => (
        <div class="role-row">
          <div class="role-meta">
            <span class="role-period mono">{role.period}</span>
            <span class="role-location">{role.location}</span>
          </div>
          <div class="role-connector">
            <div class={`role-dot ${role.current ? 'current' : ''}`}></div>
            {i < roles.length - 1 && <div class="role-line"></div>}
          </div>
          <div class="role-content">
            <div class="role-header">
              <h3 class="role-title">{role.title}</h3>
              {role.current && <span class="current-badge">current</span>}
            </div>
            <p class="role-company">{role.company}</p>
            <ul class="role-bullets">
              {role.bullets.map(b => <li>{b}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  h2 { margin-bottom: 2.5rem; }
  .timeline { display: flex; flex-direction: column; }
  .role-row {
    display: grid;
    grid-template-columns: 140px 28px 1fr;
    gap: 0 1rem;
  }
  .role-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-top: 2px;
    text-align: right;
  }
  .role-period {
    font-size: 0.78rem;
    color: var(--text-primary);
    font-weight: 500;
  }
  .role-location {
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .role-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .role-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
    border: 2px solid var(--border);
    margin-top: 5px;
    flex-shrink: 0;
    z-index: 1;
  }
  .role-dot.current {
    background: var(--accent);
    border-color: var(--accent);
  }
  .role-line {
    width: 1px;
    flex: 1;
    background: var(--border);
    margin: 4px 0;
    min-height: 24px;
  }
  .role-content { padding-bottom: 2.5rem; }
  .role-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 3px;
  }
  .role-title { font-size: 1rem; font-weight: 600; }
  .current-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 2px 8px;
    border-radius: 20px;
    background: var(--accent-light);
    color: var(--purple-800);
    border: 1px solid var(--purple-100);
  }
  .role-company {
    font-size: 0.875rem;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .role-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .role-bullets li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.65;
    padding-left: 14px;
    position: relative;
  }
  .role-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--purple-400);
    font-size: 0.75rem;
  }
  @media (max-width: 600px) {
    .role-row { grid-template-columns: 24px 1fr; }
    .role-meta { display: none; }
    .role-period-mobile { display: block; font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); margin-bottom: 4px; }
  }
</style>
