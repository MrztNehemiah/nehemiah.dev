<section id="contact">
  <div class="container">
    <p class="section-label">contact</p>
    <div class="contact-grid">
      <div class="contact-left">
        <h2>Let's work together</h2>
        <p class="contact-sub">
          Open to DevOps, SRE, and Platform Engineering roles — and always happy to talk about infrastructure, security, reliability, or GitOps.
        </p>
        <div class="contact-links">
          <a href="mailto:hello@nehemiah.dev" class="contact-item">
            <span class="contact-icon">✉</span>
            <span>hello@nehemiah.dev</span>
          </a>
          <a href="https://www.linkedin.com/in/nehemiah-daniel-844177231" target="_blank" rel="noopener" class="contact-item">
            <span class="contact-icon">in</span>
            <span>https://www.linkedin.com/in/nehemiah-daniel-844177231</span>
          </a>
          <a href="https://github.com/nehemiah-dev" target="_blank" rel="noopener" class="contact-item">
            <span class="contact-icon">{`</>`}</span>
            <span>github.com/nehemiah-dev</span>
          </a>
        </div>
      </div>
      <div class="contact-cta">
        <div class="cta-card">
          <p class="cta-label mono">currently</p>
          <p class="cta-status">Open to opportunities</p>
          <p class="cta-note">Looking for senior IC or staff-level Platform / SRE roles.</p>
          <a href="mailto:hello@nehemiah.dev" class="btn btn-primary" style="margin-top:1.25rem;width:100%;justify-content:center;">
            Send me a message
          </a>
          <a href="/resume.pdf" download class="btn btn-outline" style="margin-top:0.6rem;width:100%;justify-content:center;">
            Download résumé
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 4rem;
    align-items: start;
    margin-top: 2rem;
  }
  .contact-sub {
    font-size: 0.975rem;
    color: var(--text-secondary);
    margin: 1rem 0 2rem;
    line-height: 1.75;
  }
  .contact-links { display: flex; flex-direction: column; gap: 1rem; }
  .contact-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: color 0.15s;
  }
  .contact-item:hover { color: var(--accent); }
  .contact-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--accent);
    flex-shrink: 0;
  }
  .cta-card {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .cta-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .cta-status {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .cta-status::before {
    content: '●';
    color: #28c840;
    margin-right: 7px;
    font-size: 0.6rem;
    vertical-align: middle;
  }
  .cta-note {
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
