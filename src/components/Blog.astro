---
---
<section id="blog">
  <div class="container">
    <p class="section-label">writing</p>
    <div class="empty-state">
      <span class="mono empty-icon">_</span>
      <p class="empty-heading">Writing in progress</p>
      <p class="empty-sub">Posts on software and platform engineering are on the way.</p>
    </div>
  </div>
</section>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem;
    text-align: center;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    margin-top: 2rem;
  }
  .empty-icon {
    font-size: 1.5rem;
    color: var(--accent);
    margin-bottom: 1rem;
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
  .empty-heading {
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }
  .empty-sub {
    font-size: 0.875rem;
    color: var(--text-muted);
    max-width: 360px;
    line-height: 1.65;
  }
</style>
