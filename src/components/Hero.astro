---
---
<section id="hero">
  <div class="container">

    <div class="terminal" aria-label="Terminal introduction">
      <div class="terminal-bar">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="terminal-title">bash — nehemiah@prod</span>
      </div>
      <div class="terminal-body">
        <p class="t-line"><span class="t-prompt">$</span> <span class="t-cmd" id="cmd1"></span></p>
        <div id="output1" class="t-output" style="display:none;">
          <p><span class="t-key">name</span>    <span class="t-val">Nehemiah</span></p>
          <p><span class="t-key">role</span>    <span class="t-val">Software Engineer</span></p>
        </div>
        <p class="t-line" id="line2" style="display:none;"><span class="t-prompt">$</span> <span class="t-cmd" id="cmd2"></span></p>
        <div id="output2" class="t-output" style="display:none;">
          <p class="t-val">Build · Scale · Operate</p>
          
        </div>
        <p id="cursor-line" class="t-line" style="display:none;"><span class="t-prompt">$</span> <span class="t-cursor">▋</span></p>
        <p class="t-line" id="line3" style="display:none;"><span class="t-prompt">$</span> <span class="t-cmd" id="cmd3"></span></p>
      </div>
    </div>

    <div class="hero-actions">
      <a href="#projects" class="btn btn-primary">View my work</a>
      <a href="#contact" class="btn btn-outline">Get in touch</a>
    </div>

  </div>
</section>

<style>
  #hero {
    padding-top: calc(56px + 1.5rem);
    padding-bottom: calc(var(--section-gap) * 0.4);
  }

  .terminal {
    background: var(--gray-900);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--gray-800);
    max-width: 520px;
  }
  .terminal-bar {
    background: var(--gray-800);
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot.red    { background: #ff5f57; }
  .dot.yellow { background: #febc2e; }
  .dot.green  { background: #28c840; }
  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gray-400);
    margin-left: 8px;
  }
  .terminal-body {
    padding: 1rem 1.2rem 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: #cdd6f4;
    min-height: 168px;
  }
  .t-line { display: flex; align-items: baseline; gap: 8px; }
  .t-prompt { color: var(--purple-400); font-weight: 500; }
  .t-cmd { color: #a6e3a1; }
  .t-output { padding: 0.15rem 0 0.3rem 1rem; }
  .t-output p {
    margin: 0;
  }
  .t-key {
    color: var(--purple-400);
    min-width: 80px;
    display: inline-block;
  }
  .t-val { color: #cdd6f4; }
  .t-cursor {
    color: var(--purple-400);
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
</style>

<script>
  function typeText(el, text, speed, cb) {
    let i = 0;
    const iv = setInterval(() => {
      el.textContent += text[i++];
      if (i >= text.length) { clearInterval(iv); if (cb) cb(); }
    }, speed);
  }

  const cmd1       = document.getElementById('cmd1');
  const out1       = document.getElementById('output1');
  const line2      = document.getElementById('line2');
  const cmd2       = document.getElementById('cmd2');
  const out2       = document.getElementById('output2');
  const line3      = document.getElementById('line3');
  const cmd3       = document.getElementById('cmd3');
  const cursorLine = document.getElementById('cursor-line');

  function resetTerminal() {
    cmd1.textContent = '';
    cmd2.textContent = '';
    cmd3.textContent = '';
    out1.style.display = 'none';
    line2.style.display = 'none';
    out2.style.display = 'none';
    line3.style.display = 'none';
    cursorLine.style.display = 'none';
  }

  function runSequence() {
    typeText(cmd1, 'whoami --verbose', 55, () => {
      setTimeout(() => {
        out1.style.display = 'block';
        setTimeout(() => {
          line2.style.display = 'flex';
          typeText(cmd2, 'cat mission.txt', 55, () => {
            setTimeout(() => {
              out2.style.display = 'block';
              setTimeout(() => {
                line3.style.display = 'flex';
                typeText(cmd3, 'clear', 55, () => {
                  setTimeout(() => {
                    // pause so the "clear" command is visible before wiping
                    setTimeout(() => {
                      resetTerminal();
                      setTimeout(runSequence, 500); // brief pause on blank screen, then loop
                    }, 700);
                  }, 200);
                });
              }, 300);
            }, 200);
          });
        }, 500);
      }, 300);
    });
  }

  runSequence();
</script>